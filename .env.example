# Copy to .env and fill in. Django refuses to boot without the required ones.

SECRET_KEY=change-me

# AWS (S3 photo uploads; SES email when EMAIL_BACKEND is set to SES).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=aws-region
AWS_STORAGE_BUCKET_NAME=
AWS_S3_UPLOADS_ROOT=s3-root-folder-for-uploads

# django.core.mail.backends.console.EmailBackend (default) prints emails to
# the console; django_ses.SESBackend sends real ones.
EMAIL_BACKEND=
DEFAULT_FROM_EMAIL=
AWS_SES_REGION_NAME=

WEBSITE_NAME=WebsiteName
# Frontend origin used inside emails (verify/reset/message links).
FRONTEND_URL=http://localhost:3000

# --- Role separation / JWT ---
# Dedicated HS256 signing key (openssl rand -base64 64). Shared with the
# frontend's JWT_SIGNING_KEYS so the edge can verify tokens; keep it separate
# from SECRET_KEY. Empty = sign with SECRET_KEY (dev fallback).
JWT_SIGNING_KEY=
# Access-token lifetime. 900 (15h) is the painless dev default; run 60 in
# production — the middleware refreshes silently and every refresh re-stamps
# the role claim from the DB.
JWT_ACCESS_MINUTES=900

# Production hardening (dev defaults: DEBUG on, empty hosts).
DEBUG=True
ALLOWED_HOSTS=
